# Local Vite proxy only. Never commit a real key.
VITE_DASHSCOPE_API_KEY=

# Production frontend only needs a public proxy URL, never an API key.
# Leave empty when the proxy is served from the same origin at /api/ai.
VITE_AI_PROXY_URL=

# Production proxy server secret. Put this in the server environment, not in the frontend build.
DASHSCOPE_API_KEY=
